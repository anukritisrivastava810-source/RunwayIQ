# Environment Variables — RunwayIQ Backend
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# ─── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://anukritisrivastava@localhost:5432/runwayiq?schema=public"

# ─── Authentication ───────────────────────────────────────────────────────────
# A long, random secret key for signing JWTs
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-replace-this-in-production"

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for development.
CORS_ORIGIN=http://localhost:3000
